# ==============================================================================
# InvestWise AI 3.0 — Production Environment Template
# ==============================================================================

# --- Django Core ---
DJANGO_ENV=production
DJANGO_SECRET_KEY=your-secret-key-here-min-32-chars-change-in-production
DJANGO_ENCRYPTION_KEY=your-encryption-key-here-base64-32-bytes-change-in-production

# --- Database (PostgreSQL) ---
DB_ENGINE=django.db.backends.postgresql
POSTGRES_DB=investwise_db
POSTGRES_USER=investwise_user
POSTGRES_PASSWORD=InvestWise2026!
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgres://investwise_user:InvestWise2026!@localhost:5432/investwise_db

# --- Redis ---
REDIS_URL=redis://localhost:6379/0
REDIS_HOST=localhost
REDIS_PORT=6379
USE_REDIS_CACHE=true
CACHE_TIMEOUT=300

# --- Celery ---
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=django-db

# --- Security ---
ALLOWED_HOSTS=localhost,127.0.0.1,your-domain.com
CORS_ALLOWED_ORIGINS=http://localhost:3000,https://your-domain.com
SECURE_HSTS_SECONDS=31536000
SECURE_SSL_REDIRECT=true
SESSION_COOKIE_SECURE=true
CSRF_COOKIE_SECURE=true

# --- API Keys (External Services) ---
GEMINI_API_KEY=your-google-genai-api-key
GOOGLE_API_KEY=your-google-api-key
ELEVENLABS_API_KEY=your-elevenlabs-api-key
DEEPGRAM_API_KEY=your-deepgram-api-key
FMP_API_KEY=your-financial-modeling-prep-api-key
FINNHUB_API_KEY=your-finnhub-api-key
FRED_API_KEY=your-fred-api-key
SEC_EDGAR_USER_AGENT=InvestWise AI admin@your-domain.com
SEC_API_KEY=your-sec-api-key

# --- Email (Optional) ---
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=true
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-password

# --- Rate Limiting ---
THROTTLE_ANON_RATE=60/min
THROTTLE_USER_RATE=600/min
THROTTLE_AUTH_RATE=10/min
THROTTLE_AI_RATE=20/min

# --- Logging ---
LOG_LEVEL=WARNING

# --- AI/ML ---
CHROMADB_PERSIST_DIR=./chroma_db
AI_MODEL_DIR=./AI/models

# --- Frontend ---
VITE_API_URL=https://your-domain.com/api