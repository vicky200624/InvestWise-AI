# =============================================================================
# InvestWise AI - Backend Dockerfile (Production)
# Django REST Framework + Gunicorn + Daphne (WebSocket)
# Multi-stage build for optimized image size
# =============================================================================

# ---------- Builder Stage ----------
FROM python:3.12-slim AS builder

# Set environment variables for Python
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

# Install system dependencies for building Python packages
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    libpq-dev \
    default-libmysqlclient-dev \
    pkg-config \
    libffi-dev \
    libssl-dev \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Create and activate virtual environment
RUN python -m venv /opt/venv
ENV PATH="/opt/venv/bin:$PATH"

# Copy requirements first for better layer caching
COPY requirements.txt /tmp/requirements.txt

# Install Python dependencies
RUN pip install --upgrade pip && \
    pip install -r /tmp/requirements.txt

# ---------- Final Stage ----------
FROM python:3.12-slim AS final

# Set environment variables (Injected default SECRET_KEY fallbacks)
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    DJANGO_ENV=production \
    SECRET_KEY="django-insecure-investwise-prod-secret-key-change-in-env-file" \
    DJANGO_SECRET_KEY="django-insecure-investwise-prod-secret-key-change-in-env-file" \
    PATH="/opt/venv/bin:$PATH"

# Install runtime system dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    libpq5 \
    default-libmysqlclient-dev \
    libffi8 \
    libssl3 \
    curl \
    postgresql-client \
    && rm -rf /var/lib/apt/lists/*

# Copy virtual environment from builder
COPY --from=builder /opt/venv /opt/venv

# Create non-root user for security
RUN groupadd -r investwise && useradd -r -g investwise investwise

# Set working directory
WORKDIR /app

# Copy application code
COPY --chown=investwise:investwise backend/ /app/backend/
COPY --chown=investwise:investwise AI/ /app/AI/
COPY --chown=investwise:investwise manage.py /app/manage.py

# Create directories for static files, media, and logs
RUN mkdir -p /app/staticfiles /app/media /app/logs /app/ai_models && \
    chown -R investwise:investwise /app

# Switch to non-root user
USER investwise

# Expose port
EXPOSE 8000

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=40s --retries=3 \
    CMD curl -f http://localhost:8000/api/health/ || exit 1

# Default command (can be overridden in docker-compose)
CMD ["gunicorn", "--chdir", "/app/backend", "config.wsgi:application", \
     "--bind", "0.0.0.0:8000", \
     "--workers", "4", \
     "--worker-class", "uvicorn.workers.UvicornWorker", \
     "--timeout", "120", \
     "--keep-alive", "5", \
     "--max-requests", "1000", \
     "--max-requests-jitter", "100", \
     "--access-logfile", "-", \
     "--error-logfile", "-"]